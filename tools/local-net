#!/usr/bin/env bash
# Throwaway nodes on this computer for a test, on the regtest network.
#
#   tools/local-net up [N]     start N nodes (default 2), none mining
#   tools/local-net up N mine  node 1 also mines on the CPU (many blocks a second)
#   tools/local-net status     one line for each node
#   tools/local-net down       stop them and delete their data
#
# Node i has REST on 127.0.0.1:39<i>0 and P2P on 127.0.0.1:39<i>1; nodes 2..N
# dial node 1. Data and logs are in .local-net/ (git-ignored). Regtest has
# fixed, trivial difficulty. The nodes are stopped by process id. To mine one
# block on demand, run the GPU miner briefly against node 1:
#   gpu-miner/target/release/gpu-miner --node http://127.0.0.1:3910 --miner <address>
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
dir="$root/.local-net"; bin="$root/jcoin/target/release"
case "${1:-}" in
  up)
    n="${2:-2}"
    [ -x "$bin/node" ] || (cd "$root/jcoin" && cargo build --release --bin node --bin wallet 2>&1 | tail -1)
    [ -d "$dir" ] && "$0" down >/dev/null
    mkdir -p "$dir"
    miner="$("$bin/wallet" --key-dir "$dir/keys" key new miner | awk '/public key/ {print $3}')"
    for i in $(seq 1 "$n"); do
      args=(--regtest --rest-addr "127.0.0.1:39${i}0" --p2p-addr "127.0.0.1:39${i}1" --data-dir "$dir/node$i")
      if [ "$i" -eq 1 ]; then
        if [ "${3:-}" = mine ]; then args+=(--mine --miner "$miner"); fi
      else
        args+=(--peer 127.0.0.1:3911)
      fi
      setsid nohup "$bin/node" "${args[@]}" > "$dir/node$i.log" 2>&1 < /dev/null &
      echo $! >> "$dir/pids"
    done
    sleep 2
    echo "started $n nodes; miner key 'miner' in $dir/keys (address $miner)"
    "$0" status
    ;;
  status)
    [ -f "$dir/pids" ] || { echo "no local net is running"; exit 0; }
    i=0
    while read -r pid; do
      i=$((i + 1))
      if kill -0 "$pid" 2>/dev/null; then "$root/tools/node-status" "39${i}0" || true; else echo "node $i (pid $pid) is not running; see $dir/node$i.log"; fi
    done < "$dir/pids"
    ;;
  down)
    if [ -f "$dir/pids" ]; then while read -r pid; do kill "$pid" 2>/dev/null || true; done < "$dir/pids"; fi
    rm -rf "$dir"; echo "stopped and removed"
    ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
