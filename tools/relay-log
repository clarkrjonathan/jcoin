#!/usr/bin/env bash
# The relay's recent log, short: peer ids as <6 chars>, repeats counted.
#
#   tools/relay-log [SINCE] [PEER]
#
# SINCE is a journalctl time such as "2h" or "30min" (default 2h). PEER keeps
# only lines naming a peer id or its 6 characters after 12D3KooW.
# Needs the key ~/jcoin-relay.pem. The relay is ubuntu@3.14.123.27.
set -euo pipefail
since="${1:-2h}"; peer="${2:-}"
[ "${1:-}" = -h ] || [ "${1:-}" = --help ] && { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }
ssh -i ~/jcoin-relay.pem -o ConnectTimeout=8 -o BatchMode=yes ubuntu@3.14.123.27 \
  "systemctl is-active jcoin-relay; journalctl -u jcoin-relay --since '-$since' --no-pager -o short-iso" 2>&1 |
  sed -E 's/^([0-9-]+T)([0-9:]+)\+[0-9:]+ [^ ]+ jcoin-relay\[[0-9]+\]: /\2 /; s/12D3KooW([1-9A-HJ-NP-Za-km-z]{6})[1-9A-HJ-NP-Za-km-z]{38}/<\1>/g' |
  { if [ -n "$peer" ]; then grep -F -- "${peer#12D3KooW}" | cut -c1-200 || true; else cat; fi; } |
  awk '{ key = substr($0, 10); if (key == last) { n++ } else { if (n > 1) printf "         (x%d)\n", n; print; n = 1; last = key } } END { if (n > 1) printf "         (x%d)\n", n }' |
  tail -60
