#!/usr/bin/env python3
"""The state of a local node, in a few lines.

  tools/node-status [PORT] [ADDR] [--peers] [--blocks N] [--wait COND [SECS]]
                    [--data DIR] [--ssh SERVER]

  PORT        a node whose REST server is on 127.0.0.1:PORT; without it, the
              desktop app on this computer, through its local API (2.4.0 and
              later; the line then also says whether it mines), or for an
              older app its node, found from the app's log
  --data DIR  the app's data folder, for an app started with JCOIN_APP_DATA
  --ssh SERVER  a node on another computer, read through an ssh tunnel to
              its 127.0.0.1:PORT (PORT defaults to 3000). SERVER is `relay`
              (the public node on ubuntu@3.14.123.27, key ~/jcoin-relay.pem),
              `imac` (miner@ the address tools/imac-deploy last found, else
              jcoin-miner.local), or USER@HOST
  ADDR        also the balance of this address (64 hex)
  --peers     one line per open connection: peer, label, direct or relayed,
              whether it carries a session, its address
  --blocks N  the last N blocks (at most 100): height, time after the block
              before, difficulty bits, miner; and the average block time
  --wait COND wait until COND holds, checking every second, for at most SECS
              (default 60); exit 1 on timeout. COND is one of:
                direct     a direct (not relayed) session with another node
                peers=N    at least N connections with a session
                height=N   the chain is at height N or more
                nonce=ADDR:N  ADDR's confirmed nonce is N or more: a
                           transfer it sent with nonce N-1 is in a block

The first line always gives height, difficulty, connections, the newer-rules
signal, and the balance if an address is known.
"""
import atexit, json, math, os, re, socket, subprocess, sys, time, urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import jcoin_api  # noqa: E402


class Node:
    """A node's own REST server."""

    def __init__(self, port):
        self.port = port
        self.label = f"127.0.0.1:{port}"
        self.api = None

    def get(self, path):
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{self.port}{path}", timeout=3) as r:
                return json.load(r)
        except Exception:
            return None


def ssh_target(server):
    """`ssh` arguments (options and USER@HOST) for a --ssh SERVER name."""
    opts = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=6", "-o", "LogLevel=ERROR",
            "-o", "StrictHostKeyChecking=accept-new", "-o", "ExitOnForwardFailure=yes"]
    if server == "relay":
        return opts + ["-i", os.path.expanduser("~/jcoin-relay.pem"), "ubuntu@3.14.123.27"]
    if server == "imac":
        cache = os.path.expanduser("~/.cache/jcoin/imac-host")
        host = open(cache).read().strip() if os.path.exists(cache) else "jcoin-miner.local"
        return opts + [f"miner@{host}"]
    return opts + [server]


def tunnel(server, remote_port):
    """Forward a free local port to the server's 127.0.0.1:remote_port for the
    life of this program; returns the local port."""
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        local = s.getsockname()[1]
    proc = subprocess.Popen(["ssh", "-N", "-L", f"{local}:127.0.0.1:{remote_port}", *ssh_target(server)],
                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    atexit.register(proc.terminate)
    for _ in range(80):
        if proc.poll() is not None:
            sys.exit(f"ssh to {server} failed: {proc.stderr.read().strip()[-300:]}")
        try:
            with socket.create_connection(("127.0.0.1", local), timeout=0.2):
                return local
        except OSError:
            time.sleep(0.1)
    sys.exit(f"ssh tunnel to {server} did not open")


class App:
    """The desktop app's node, through the app's local API."""

    NODE_PATHS = {"/network/signal": "/api/node/signal"}

    def __init__(self, api):
        self.api = api
        self.label = f"app ({api.base})"

    def get(self, path):
        base, _, query = path.partition("?")
        mapped = self.NODE_PATHS.get(base, "/api/node" + base)
        return self.api.get(mapped + ("?" + query if query else ""))


def app_log():
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    path = os.path.join(base, "jeffycoin", "jeffycoin.log")
    return open(path, errors="replace").read() if os.path.exists(path) else ""


def bits(target_hex):
    return 256 - math.log2(int(target_hex, 16) + 1)


def span(secs):
    secs = int(secs)
    if secs < 60:
        return f"{secs} s"
    if secs < 3600:
        return f"{secs // 60} min {secs % 60} s"
    return f"{secs // 3600} h {secs % 3600 // 60} min"


def summary(src, address):
    chain = src.get("/chain")
    if chain is None:
        return None
    parts = [f"height {chain['height']}", f"tip {bits(chain['target']):.1f} bits"]
    peers = src.get("/peers")
    if peers:
        conns = peers["connections"]
        sessions = sum(1 for c in conns if c["session"])
        relayed = sum(1 for c in conns if c["relayed"])
        parts.append(f"{len(conns)} connections ({sessions} exchanging blocks, {relayed} through the relay)")
    else:
        parts.append(f"{chain.get('peers', '?')} peers")
    signal = src.get("/network/signal")
    if signal and signal["level"] != "none":
        parts.append(f"newer rules: {signal['level']} (version {signal['newest_version']}, {signal['blocks']} blocks)")
    if address:
        account = src.get(f"/balance/{address}")
        if account:
            parts.append(f"balance {account['balance'] / 1e8:g} JEF, pending {account['pending'] / 1e8:g}, nonce {account['nonce']}")
    if src.api:
        m = src.api.get("/api/mining")
        if m and m["state"] == "running":
            parts.append(f"mining {m['hash_rate'] / 1e6:.1f} MH/s at {m['gpu_limit']}%")
        elif m:
            parts.append(f"mining {m['state']}" + (f" ({m['error']})" if m.get("error") else ""))
    return f"{src.label}: " + "; ".join(parts)


def print_peers(src):
    peers = src.get("/peers") or {"connections": []}
    for c in peers["connections"]:
        kind = "relay" if c["is_relay"] else ("relayed" if c["relayed"] else "direct")
        label = c.get("label") or "-"
        session = "session" if c["session"] else "no session"
        print(f"  {c['peer'][-6:]}  {label:<14} {kind:<8} {session:<10} {c['address'][:70]}")
    if not peers["connections"]:
        print("  no connections")


def print_blocks(src, n):
    recent = src.get(f"/chain/recent?count={n}")
    if recent is None:
        print("  no /chain/recent (node older than 2.2.3?)")
        return
    for b in recent["blocks"]:
        gap = span(b["gap"]) if b["gap"] is not None else "genesis"
        miner = b["miner"][:10] if b["miner"] else "-"
        print(f"  {b['height']:>6}  after {gap:<12} {bits(b['target']):5.1f} bits  miner {miner}  transfers {b['transfers']}")
    if recent["average_gap"] is not None:
        print(f"  average {span(recent['average_gap'])}; last block {span(recent['since_tip'] or 0)} ago")


def holds(src, cond):
    if cond == "direct":
        peers = src.get("/peers") or {"connections": []}
        return any(c["session"] and not c["relayed"] and not c["is_relay"] for c in peers["connections"])
    name, _, value = cond.partition("=")
    if name == "peers":
        peers = src.get("/peers") or {"connections": []}
        return len({c["peer"] for c in peers["connections"] if c["session"]}) >= int(value)
    if name == "nonce":
        address, _, n = value.partition(":")
        account = src.get(f"/balance/{address}")
        return account is not None and account["nonce"] >= int(n)
    if name == "height":
        chain = src.get("/chain")
        return chain is not None and chain["height"] >= int(value)
    sys.exit(f"unknown condition {cond!r}; see --help")


def main():
    argv = sys.argv[1:]
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return
    show_peers = "--peers" in argv
    argv = [a for a in argv if a != "--peers"]
    blocks = wait = data = server = None
    timeout = 60
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--blocks":
            blocks = min(int(argv[i + 1]), 100)
            i += 2
        elif a == "--data":
            data = argv[i + 1]
            i += 2
        elif a == "--ssh":
            server = argv[i + 1]
            i += 2
        elif a == "--wait":
            wait = argv[i + 1]
            i += 2
            if i < len(argv) and argv[i].isdigit() and len(argv[i]) < 6:
                timeout = int(argv[i])
                i += 1
        elif a.startswith("-"):
            sys.exit(f"unknown option {a}; see --help")
        else:
            rest.append(a)
            i += 1
    port = rest[0] if rest else None
    address = rest[1] if len(rest) > 1 else None
    if server:
        src = Node(tunnel(server, port or "3000"))
        src.label = f"{server}:{port or 3000}"
    elif port is not None:
        src = Node(port)
    else:
        api = jcoin_api.find(data)
        status = api.get("/api/status") if api else None
        if status:
            src = App(api)
            address = address or status["key"]["address"]
        else:
            # An app before 2.4.0 (no API): its node's port is in the log.
            log = app_log()
            ports = re.findall(r"REST on 127\.0\.0\.1:(\d+)", log)
            keys = re.findall(r"key '[^']+' ([0-9a-f]{64})", log)
            if not ports:
                sys.exit("no app answers on its API and no app log found; give a port")
            src = Node(ports[-1])
            address = address or (keys[-1] if keys else None)

    if wait:
        start = time.time()
        while not holds(src, wait):
            if time.time() - start > timeout:
                print(f"{src.label}: '{wait}' did not hold within {timeout} s")
                print(summary(src, address) or f"no node answers at {src.label}")
                sys.exit(1)
            time.sleep(1)
        print(f"{src.label}: '{wait}' holds after {time.time() - start:.0f} s")

    line = summary(src, address)
    if line is None:
        sys.exit(f"no node answers at {src.label}")
    print(line)
    if show_peers:
        print_peers(src)
    if blocks:
        print_blocks(src, blocks)


if __name__ == "__main__":
    main()
