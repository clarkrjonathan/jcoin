#!/usr/bin/env bash
# Build and test the packages; print one line for each, and detail only for
# failures.
#
#   tools/check                 test jcoin, gpu-miner, app
#   tools/check jcoin app       only those packages
#   tools/check --gpu           also the app's GPU end-to-end test (needs a GPU, ~10 s)
#   tools/check --build         also build the release programs
#
# Exit status is 0 only if everything passed.
set -u
root="$(cd "$(dirname "$0")/.." && pwd)"
gpu=0; build=0; packages=()
for arg in "$@"; do
  case "$arg" in
    --gpu) gpu=1 ;;
    --build) build=1 ;;
    -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    jcoin|gpu-miner|app) packages+=("$arg") ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done
[ ${#packages[@]} -eq 0 ] && packages=(jcoin gpu-miner app)
status=0

# Run cargo in a package; print "name: summary", or the failure detail.
run() { # label package cargo-args...
  local label=$1 package=$2; shift 2
  local out; out="$(cd "$root/$package" && cargo "$@" 2>&1)"; local code=$?
  if [ $code -eq 0 ]; then
    local passed ignored
    passed=$(grep -oE "^test result: ok\. [0-9]+ passed" <<<"$out" | awk '{s+=$4} END {print s+0}')
    ignored=$(grep -oE "[0-9]+ ignored" <<<"$out" | awk '{s+=$1} END {print s+0}')
    case "$1" in
      test) if [ "$ignored" -gt 0 ]; then echo "$label: $passed passed, $ignored ignored"; else echo "$label: $passed passed"; fi ;;
      *) echo "$label: built" ;;
    esac
  else
    status=1
    echo "$label: FAILED"
    # Compiler errors, failed test names, and panic messages; not the whole log.
    grep -E "^error|^ +--> |^test .* FAILED|panicked at|assertion|^  (left|right):|^failures:" <<<"$out" | head -40 | sed 's/^/    /'
  fi
}

for package in "${packages[@]}"; do
  run "$package" "$package" test --release
  [ $build -eq 1 ] && run "$package (build)" "$package" build --release
  if [ "$package" = app ] && [ $gpu -eq 1 ]; then
    run "app (GPU end to end)" app test --release -- --ignored
  fi
done
exit $status
